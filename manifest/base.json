{
  "manifest_version": 3,
  "name": "Grindskip",
  "description": "Plays gameplay videos fast while no one is talking and at normal speed while someone is. Speech is detected on your computer.",
  "permissions": ["storage"],
  "icons": {
    "16": "icon-16.png",
    "32": "icon-32.png",
    "48": "icon-48.png",
    "128": "icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Grindskip",
    "default_icon": {
      "16": "icon-16.png",
      "32": "icon-32.png"
    }
  },
  "commands": {
    "toggle": {
      "suggested_key": { "default": "Alt+Shift+G" },
      "description": "Turn Grindskip on or off"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["ort-wasm-simd-threaded.wasm", "silero_vad.onnx"],
      "matches": ["<all_urls>"]
    }
  ]
}
